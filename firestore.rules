rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados (vendedores/administradores logueados en la app)
    // pueden leer o escribir datos. Nadie puede acceder sin iniciar sesión.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
